{
  "name": "moje-auto",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "nub run --workspace @moje-auto/mobile dev",
    "start": "nub run --workspace @moje-auto/mobile start",
    "android": "nub run --workspace @moje-auto/mobile android",
    "db:check": "nub run --workspace @moje-auto/mobile db:check",
    "db:generate": "nub run --workspace @moje-auto/mobile db:generate",
    "ios": "nub run --workspace @moje-auto/mobile ios",
    "web": "nub run --workspace @moje-auto/mobile web",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "nub run --workspace @moje-auto/mobile test",
    "typecheck": "nub run --workspace @moje-auto/mobile typecheck",
    "check": "nub run lint && nub run format:check && nub run typecheck && nub run db:check && nub run test",
    "deps:install": "nubx -y sfw@2.0.6 nub install",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "fastq": "1.20.3",
    "husky": "9.1.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "sfw": "2.0.6"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.8.0",
      "onFail": "ignore"
    }
  }
}
