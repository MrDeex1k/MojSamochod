diff --git a/Package.swift b/Package.swift
new file mode 100644
--- /dev/null
+++ b/Package.swift
@@ -0,0 +1,39 @@
+// swift-tools-version: 6.2
+import PackageDescription
+
+// Compile against React's invariant header products supplied by Expo autolinking.
+// Runtime React and Hermes frameworks are linked by the host app.
+let root = Context.packageDirectory
+let package = Package(
+  name: "expo-modules-jsi",
+  platforms: [.iOS("16.4")],
+  products: [.library(name: "ExpoModulesJSI", type: .dynamic, targets: ["ExpoModulesJSI"])],
+  dependencies: [],
+  targets: [
+    .target(
+      name: "ExpoModulesJSI-Cxx",
+      path: "apple/Sources/ExpoModulesJSI-Cxx",
+      publicHeadersPath: "include",
+      cxxSettings: [.headerSearchPath("include/Public")]
+    ),
+    .target(
+      name: "ExpoModulesJSI",
+      dependencies: ["ExpoModulesJSI-Cxx"],
+      path: "apple/Sources/ExpoModulesJSI",
+      swiftSettings: [
+        .interoperabilityMode(.Cxx),
+        .enableUpcomingFeature("NonisolatedNonsendingByDefault"),
+        .enableUpcomingFeature("InferIsolatedConformances"),
+        .unsafeFlags([
+          "-Xfrontend", "-clang-header-expose-decls=has-expose-attr",
+          "-Xcc", "-fmodule-map-file=\(root)/spm/jsi.modulemap",
+          "-Xcc", "-iapinotes-modules",
+          "-Xcc", "\(root)/apple/APINotes"
+        ])
+      ],
+      linkerSettings: [.unsafeFlags(["-Xlinker", "-undefined", "-Xlinker", "dynamic_lookup"])]
+    )
+  ],
+  swiftLanguageModes: [.v6],
+  cxxLanguageStandard: .cxx20
+)
